<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Drift" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/window_bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:colorAccent">#FFFFFFFF</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Dialog.Drift" parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>
</resources>
