<?xml version="1.0" encoding="utf-8"?>
<!-- "A window came to the front" (acted on only for the stock launchers) and "a notification was
     posted" (only media notifications are used, for their player token). No screen content. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="0"
    android:canRetrieveWindowContent="false"
    android:description="@string/guard_description"
    android:summary="@string/guard_summary" />
